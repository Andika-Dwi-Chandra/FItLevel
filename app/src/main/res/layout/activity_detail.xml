<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackgroundDark">

    <!-- Toolbar dengan tombol Back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/CardDark"
        app:titleTextColor="@color/TextGold"
        app:subtitleTextColor="@color/TextWhite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardBackgroundColor="@color/CardDark"
            app:cardCornerRadius="75dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/imgProject"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:padding="16dp"
                android:src="@drawable/ic_logo_fitlevel" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvProjectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/saintcarell"
            android:text="PushUp Blitz"
            android:textAlignment="center"
            android:textColor="@color/TextGold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/nunito_regular"
            android:text="Kesulitan: MEDIUM • Hadiah: +120 EXP"
            android:textColor="@color/ButtonBlue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProjectDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_regular"
            android:lineSpacingExtra="6dp"
            android:text="Aplikasi gaya hidup sehat berbasis gamifikasi. Jaga punggung lurus dari kepala hingga tumit, turunkan dada hampir menyentuh lantai, dan kumpulkan EXP setiap selesai workout!"
            android:textAlignment="center"
            android:textColor="@color/TextWhite"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>