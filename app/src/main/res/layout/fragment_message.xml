<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackgroundDark"
    tools:context=".Message.MessageFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/CardDark"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/CardDark"
            app:layout_scrollFlags="scroll|enterAlways"
            app:subtitleTextColor="@color/TextWhite"
            app:titleTextColor="@color/TextGold" />

        <!-- ChipGroup Filter Kategori Quest sesuai Desain Figma & Modul Pertemuan 9 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupQuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSemua"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Semua"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/BackgroundDark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHarian"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harian"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/BackgroundDark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMingguan"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mingguan"
                android:textColor="@color/white"
                app:chipBackgroundColor="@color/BackgroundDark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSpesial"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spesial"
                android:textColor="@color/TextGold"
                app:chipBackgroundColor="@color/BackgroundDark" />

        </com.google.android.material.chip.ChipGroup>

    </com.google.android.material.appbar.AppBarLayout>

    <ListView
        android:id="@+id/listMessageItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>